# PostgreSQL service (docker compose). Defaults shown; keep DATABASE_URL below in sync when running locally.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stellar_one
POSTGRES_PORT=5432

# Host port the app is published on (docker compose)
APP_PORT=8000

# Host port the frontend (Vite dev server) is published on (docker compose)
FRONTEND_PORT=5173

# Used when running the app locally (outside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stellar_one

# LLM Configuration (any OpenAI-compatible endpoint; defaults to OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Custom endpoint, e.g. Ollama: http://localhost:11434/v1 (set OPENAI_API_KEY to any non-empty value)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama Embedding Configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# DATABASE_URL for the app container in docker compose; defaults to the db service built from POSTGRES_* above
# DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/stellar_one
# Ollama address used by the app container in docker compose
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Chat LLM base URL used by the app container; defaults to OPENAI_BASE_URL above
# DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Generation settings
MAX_RETRIES=5
SIMILARITY_THRESHOLD=0.30

# Frontend props (Vite only exposes variables prefixed with VITE_ to the React app).
# Docker: written to /env.js when the frontend container starts (restart to apply changes).
# Local `pnpm dev`: read from this file by Vite.
# Backend URL the browser calls; must be reachable from your browser, not from inside Docker.
VITE_API_URL=http://localhost:8000
